<Window x:Class="TreeDump.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace &amp; Application Settings — TreeDump Pro"
        Width="740" Height="690"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontUI}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== STUDIO HEADER ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceHeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource PurpleSubtle}"
                        BorderBrush="{DynamicResource PurpleText}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FontIcon}"
                               FontSize="18" Foreground="{DynamicResource PurpleText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings &amp; Scanner Rules"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Configure studio theme, code editor typography, directory exclusions, and handoff rules."
                               FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== SETTINGS CARDS ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
            <StackPanel>

                <!-- 1. Appearance & Editor -->
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="24" Height="24" CornerRadius="6"
                                    Background="{DynamicResource AccentSubtle}" Margin="0,0,8,0">
                                <TextBlock Text="&#xE790;" FontFamily="{DynamicResource FontIcon}"
                                           FontSize="12" Foreground="{DynamicResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Appearance &amp; Code Editor"
                                       FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Color Theme:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="CmbTheme" Grid.Column="1" Style="{StaticResource StandardComboBox}">
                                <ComboBoxItem Content="Dark (Obsidian Studio)" Tag="Dark"/>
                                <ComboBoxItem Content="Light (Crisp Daylight)" Tag="Light"/>
                                <ComboBoxItem Content="Follow System (Windows 10/11 Mode)" Tag="System"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Editor Font Family:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="CmbEditorFont" Grid.Column="1" Style="{StaticResource StandardComboBox}">
                                <ComboBoxItem Content="Cascadia Code, Consolas, Courier New" Tag="Cascadia Code, Consolas, Courier New"/>
                                <ComboBoxItem Content="Consolas, Courier New" Tag="Consolas, Courier New"/>
                                <ComboBoxItem Content="JetBrains Mono, Cascadia Code, Consolas" Tag="JetBrains Mono, Cascadia Code, Consolas"/>
                                <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Editor Font Size:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="CmbFontSize" Grid.Column="1" Style="{StaticResource StandardComboBox}">
                                <ComboBoxItem Content="12 px (Compact)" Tag="12"/>
                                <ComboBoxItem Content="13 px (Default Studio)" Tag="13"/>
                                <ComboBoxItem Content="14 px (Comfortable)" Tag="14"/>
                                <ComboBoxItem Content="15 px (Medium)" Tag="15"/>
                                <ComboBoxItem Content="16 px (Large)" Tag="16"/>
                                <ComboBoxItem Content="18 px (Presentation)" Tag="18"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkWordWrap"
                                  Content="Enable Word Wrap in Code Preview Editor by default"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Scanner Filter Rules -->
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="24" Height="24" CornerRadius="6"
                                    Background="{DynamicResource WarningSubtle}" Margin="0,0,8,0">
                                <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource FontIcon}"
                                           FontSize="12" Foreground="{DynamicResource WarningText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Directory &amp; Extension Ignore Lists"
                                       FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Comma-separated names. Ignored items are skipped during workspace scanning and global search."
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                        <TextBlock Text="Ignored Folder Names:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtIgnoredFolders"
                                 Style="{StaticResource InputTextBox}"
                                 Height="58"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="{DynamicResource FontMono}"
                                 FontSize="11.5"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Ignored File Extensions:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtIgnoredExtensions"
                                 Style="{StaticResource InputTextBox}"
                                 Height="58"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="{DynamicResource FontMono}"
                                 FontSize="11.5"
                                 Margin="0,0,0,12"/>

                        <DockPanel LastChildFill="False">
                            <CheckBox x:Name="ChkRespectGitIgnore"
                                      DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      Content="Automatically parse and respect project .gitignore rules during scan"/>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource BtnGhost}"
                                    Padding="10,5"
                                    Click="BtnRestoreDefaultFilters_Click"
                                    ToolTip="Reset ignored folders and extensions to built-in defaults">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{DynamicResource FontIcon}" FontSize="11"
                                               Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Restore Default Filters" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 3. AI Handoff Rules File -->
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="24" Height="24" CornerRadius="6"
                                    Background="{DynamicResource PurpleSubtle}" Margin="0,0,8,0">
                                <TextBlock Text="&#xE945;" FontFamily="{DynamicResource FontIcon}"
                                           FontSize="12" Foreground="{DynamicResource PurpleText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AI Handoff Rules File (Optional)"
                                       FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Path to a custom Markdown rules file (e.g. .clinerules/laws.md) to embed when generating AI Handoff prompts."
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRulesPath"
                                     Grid.Column="0"
                                     Style="{StaticResource InputTextBox}"
                                     FontFamily="{DynamicResource FontMono}"
                                     FontSize="11.5"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="6,0,0,0"
                                    Padding="12,6"
                                    Click="BtnBrowseRules_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="{DynamicResource FontIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Database & Maintenance -->
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="22" Height="22" CornerRadius="6"
                                        Background="{DynamicResource DangerSubtle}" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FontIcon}"
                                               FontSize="11" Foreground="{DynamicResource DangerText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Export History &amp; Sent File Tracking"
                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Clear all recorded export sessions and reset 'SENT' badges across all workspaces."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="BtnClearHistory"
                                Grid.Column="1"
                                Content="Clear Sent History"
                                Style="{StaticResource BtnDanger}"
                                VerticalAlignment="Center"
                                Click="BtnClearHistory_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           Grid.Column="0"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource SuccessText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel (Esc)"
                            Style="{StaticResource BtnSecondary}"
                            Width="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button Style="{StaticResource BtnPrimary}"
                            Width="145"
                            IsDefault="True"
                            Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="12.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Save Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>