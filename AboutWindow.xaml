<Window x:Class="TreeDump.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeDump"
        Title="About TreeDump Pro"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBase}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreditLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CreditValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Hero -->
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="28,28,28,22">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="{StaticResource AppLogo}"
                       Width="96"
                       Height="96"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="TreeDump Pro logo" />

                <TextBlock Text="{x:Static local:AppInfo.Name}"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />

                <Border Background="{DynamicResource AccentSubtle}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,2"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <TextBlock Text="{x:Static local:AppInfo.VersionLabel}"
                               FontFamily="{StaticResource CodeFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" />
                </Border>

                <TextBlock Text="{x:Static local:AppInfo.Tagline}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Credits -->
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14"
                Margin="24,20,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CreditLabel}" Text="AUTHOR" Margin="0,0,0,10" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource CreditValue}" Text="{x:Static local:AppInfo.Author}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CreditLabel}" Text="GITHUB" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CreditValue}" Margin="0,0,0,10">
                    <Hyperlink x:Name="LnkGitHub" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{x:Static local:AppInfo.GitHubUrl}" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CreditLabel}" Text="TELEGRAM" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CreditValue}">
                    <Hyperlink x:Name="LnkTelegram" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{x:Static local:AppInfo.TelegramUrl}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Text="{x:Static local:AppInfo.Copyright}"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11.5"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0" />

        <!-- Actions -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,18,24,22">
            <Button x:Name="BtnCopyCredits"
                    Content="Copy Credits"
                    Style="{StaticResource BtnSecondary}"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="BtnCopyCredits_Click" />
            <Button Content="Close"
                    Style="{StaticResource BtnPrimary}"
                    MinWidth="90"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnClose_Click" />
        </StackPanel>
    </StackPanel>
</Window>